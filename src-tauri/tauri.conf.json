{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unilink",
  "version": "0.1.0",
  "identifier": "community.unilink.desktop",
  "build": {
    "beforeDevCommand": "npm run build:sidecar",
    "beforeBuildCommand": "npm run build:sidecar",
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "externalBin": [
      "binaries/unilink-server"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Share Stremio sources across your local network",
    "longDescription": "Unilink connects Stremio to a browser on another device on the same local network."
  }
}
